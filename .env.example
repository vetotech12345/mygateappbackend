# Copy to .env and fill in. Never commit .env. Every value below is a PLACEHOLDER, not a working secret.
# The dev profile runs without a .env file. The prod profile refuses to start without the values marked REQUIRED.

# dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL (REQUIRED in prod)
DB_URL=jdbc:postgresql://localhost:5432/mygateapp
DB_USERNAME=mygateapp
DB_PASSWORD=change-me

# Redis: OTP store, rate limits, idempotency keys
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (REQUIRED in prod). At least 32 random bytes, for example the output of: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P30D

# Push notifications: log (development) or firebase.
# FIREBASE_CREDENTIALS_PATH points to a service-account JSON file mounted as a secret (never commit it).
PUSH_PROVIDER=log
FIREBASE_CREDENTIALS_PATH=

# SMS for OTP (REQUIRED in prod): mock (dev only, refused by prod) | twilio | none
SMS_PROVIDER=mock
SMS_ACCOUNT_ID=
SMS_API_KEY=
# Sender phone number, or a Twilio Messaging Service SID starting with MG
SMS_SENDER_ID=

# Browser origins allowed to call the API (React admin panel, Flutter web), comma separated (REQUIRED in prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Absolute public base URL used in signed file links when running behind a proxy, e.g. https://api.example.com
PUBLIC_BASE_URL=
FILE_STORAGE_DIR=./data/uploads

# Optional tuning
RATE_LIMIT_PER_MINUTE=240
# Expose Swagger UI in prod only when set to true
SWAGGER_ENABLED=false
